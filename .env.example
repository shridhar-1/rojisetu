# Copy to .env for local dev. On Vercel set these in the dashboard, never in code.

# PostgreSQL connection string (Neon / Supabase / Vercel Postgres all work)
DATABASE_URL=

# AI lanes (same keys as MediKiosk: Ollama local -> Groq -> Gemini)
GROQ_API_KEY=
GEMINI_API_KEY=

# Demo backdoors and demo data are only enabled when this is exactly "true"
DEMO_MODE=true
